# SECRETS -- must never enter an image layer. They arrive at runtime as
# read-only mounts instead (see docker-compose.yml). A layer is forever: once
# a credential is baked in, deleting it in a later layer does not remove it.
.env
.env.*
.tokens.json
.tokens.json.lock
keys/

# Live data. car.db belongs on a volume, not in the image -- baking it in
# would ship a snapshot that silently diverges from the mounted one.
car.db
car.db-shm
car.db-wal
data/
*.log

# Local-only
.venv/
.git/
.gitignore
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.superpowers/
docs/
tools/
node_modules/
.DS_Store
