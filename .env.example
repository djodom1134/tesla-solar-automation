# Copy to .env and fill in. Never commit .env.

# From your app on https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# The domain you control that hosts the public key at
#   https://<TESLA_DOMAIN>/.well-known/appspecific/com.tesla.3p.public-key.pem
# Must match the root domain of the Allowed Origin on your Tesla app.
TESLA_DOMAIN=

# Must EXACTLY match a redirect URI registered on your Tesla app.
# If you registered a URI on your own domain instead, put it here and use the
# "Paste callback URL" flow in the app after authorizing.
TESLA_REDIRECT_URI=http://localhost:8000/auth/callback

# na = North America / Asia-Pacific   eu = Europe/ME/Africa   cn = China
TESLA_REGION=na

# IANA name. Tesla buckets energy by *your site's* local day, so this must be the
# site's timezone or the daily totals will be shifted.
TESLA_TIMEZONE=America/Los_Angeles

HOST=127.0.0.1
PORT=8000

# Optional. Set both to see an estimated cost/credit readout. Leave blank to hide it.
IMPORT_RATE_PER_KWH=
EXPORT_RATE_PER_KWH=
CURRENCY=USD
